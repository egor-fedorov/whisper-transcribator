cmake_minimum_required(VERSION 3.22)

set(WT_SOURCE_REVISION "@WT_SOURCE_REVISION@")
set(WT_SOURCE_DIRTY "@WT_SOURCE_DIRTY@")
set(WT_WHISPER_REVISION "@WT_WHISPER_REVISION@")
set(WT_CLI11_VERSION "@WT_CLI11_VERSION@")
set(WT_JSON_VERSION "@WT_JSON_VERSION@")
set(WT_PACKAGE_FLAVOR cpu)
if("@WT_CUDA@" AND "@WT_VULKAN@")
  set(WT_PACKAGE_FLAVOR mixed)
elseif("@WT_VULKAN@")
  set(WT_PACKAGE_FLAVOR vulkan)
elseif("@WT_CUDA@")
  set(WT_PACKAGE_FLAVOR cuda)
elseif("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
  set(WT_PACKAGE_FLAVOR metal)
endif()
set(WT_TARGET_ARCH "@CMAKE_SYSTEM_PROCESSOR@")
if(WT_TARGET_ARCH MATCHES "^(AMD64|amd64)$")
  set(WT_TARGET_ARCH x86_64)
elseif("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows" AND WT_TARGET_ARCH MATCHES "^(ARM64|arm64|aarch64)$")
  set(WT_TARGET_ARCH arm64)
endif()
# Named as in archive file names.
string(TOLOWER "@CMAKE_SYSTEM_NAME@" WT_TARGET_OS)
if(WT_TARGET_OS STREQUAL "darwin")
  set(WT_TARGET_OS macos)
endif()
if(WT_SOURCE_REVISION STREQUAL "")
  find_program(WT_GIT git)
  if(WT_GIT AND EXISTS "@CMAKE_CURRENT_SOURCE_DIR@/.git")
    execute_process(COMMAND "${WT_GIT}" rev-parse HEAD WORKING_DIRECTORY "@CMAKE_CURRENT_SOURCE_DIR@"
      OUTPUT_VARIABLE WT_SOURCE_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${WT_GIT}" status --porcelain --untracked-files=no
      WORKING_DIRECTORY "@CMAKE_CURRENT_SOURCE_DIR@" OUTPUT_VARIABLE status RESULT_VARIABLE status_result ERROR_QUIET)
    if(NOT status_result EQUAL 0)
      set(WT_SOURCE_DIRTY unknown)
    elseif(status STREQUAL "")
      set(WT_SOURCE_DIRTY false)
    else()
      set(WT_SOURCE_DIRTY true)
    endif()
  endif()
endif()
if(WT_SOURCE_REVISION STREQUAL "")
  set(WT_SOURCE_REVISION unknown)
endif()
if(WT_SOURCE_DIRTY STREQUAL "")
  set(WT_SOURCE_DIRTY unknown)
endif()
if(NOT WT_SOURCE_REVISION STREQUAL "unknown")
  string(LENGTH "${WT_SOURCE_REVISION}" revision_length)
  if(NOT WT_SOURCE_REVISION MATCHES "^[0-9a-f]+$" OR NOT revision_length EQUAL 40)
    message(FATAL_ERROR "WT_SOURCE_REVISION must be a full lowercase Git SHA or unknown")
  endif()
endif()
if(NOT WT_SOURCE_DIRTY MATCHES "^(true|false|unknown)$")
  message(FATAL_ERROR "WT_SOURCE_DIRTY must be true, false or unknown")
endif()
set(WT_VERSION "@PROJECT_VERSION@@WT_VERSION_SUFFIX@")
if(NOT "@WT_VERSION_SUFFIX@" STREQUAL "")
  if(WT_SOURCE_REVISION STREQUAL "unknown")
    string(APPEND WT_VERSION "+unknown")
  else()
    string(SUBSTRING "${WT_SOURCE_REVISION}" 0 12 short_revision)
    string(APPEND WT_VERSION "+g${short_revision}")
  endif()
  if(WT_SOURCE_DIRTY STREQUAL "true")
    string(APPEND WT_VERSION ".dirty")
  elseif(WT_SOURCE_DIRTY STREQUAL "unknown")
    string(APPEND WT_VERSION ".state-unknown")
  endif()
endif()
set(WT_SOURCE_DIRTY_JSON "${WT_SOURCE_DIRTY}")
if(WT_SOURCE_DIRTY STREQUAL "unknown")
  set(WT_SOURCE_DIRTY_JSON null)
endif()
configure_file("@CMAKE_CURRENT_SOURCE_DIR@/cmake/version.hpp.in" "@CMAKE_CURRENT_BINARY_DIR@/generated/version.hpp" @ONLY)
configure_file("@CMAKE_CURRENT_SOURCE_DIR@/cmake/package.env.in" "@CMAKE_CURRENT_BINARY_DIR@/generated/package.env" @ONLY)
